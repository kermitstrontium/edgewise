{
  "name": "Edgewise",
  "short_name": "Edgewise",
  "description": "One line through every square. Finish on the edge and the next grid opens.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#11151f",
